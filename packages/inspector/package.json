{
  "name": "ai-tool-inspector",
  "version": "0.1.0",
  "description": "A tiny local browser inspector for manually executing Vercel AI SDK tools.",
  "keywords": [
    "ai",
    "ai-sdk",
    "vercel-ai-sdk",
    "tools",
    "tool-calling",
    "inspector",
    "developer-tools",
    "llm",
    "typescript"
  ],
  "license": "MIT",
  "author": "Tauheed Butt",
  "homepage": "https://github.com/tauheedbuttt/ai-tool-inspector#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tauheedbuttt/ai-tool-inspector.git",
    "directory": "packages/inspector"
  },
  "bugs": {
    "url": "https://github.com/tauheedbuttt/ai-tool-inspector/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "ai-tool-inspector": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "pnpm run build:lib && pnpm run build:ui",
    "build:ui": "vite build --config ui/vite.config.ts",
    "build:lib": "tsup",
    "dev:ui": "vite --config ui/vite.config.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ai-sdk/provider-utils": "^5.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.1",
    "ai": "^7.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tsup": "^8.5.0",
    "vite": "^7.1.12",
    "zod": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
