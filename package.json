{
  "name": "ai-tool-inspector-workspace",
  "private": true,
  "version": "0.0.0",
  "description": "Workspace for ai-tool-inspector",
  "packageManager": "pnpm@10.23.0",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "build": "pnpm --filter ai-tool-inspector build",
    "dev": "pnpm --filter playground dev",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --build --force",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "devDependencies": {
    "@eslint/js": "^9.38.0",
    "@types/node": "^22.18.0",
    "eslint": "^9.38.0",
    "globals": "^16.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^3.2.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
